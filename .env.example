# Supabase — optional. With these unset the app runs on the seeded demo
# class alone, which is how the live demo stays up if anything is missing.
#
# Project settings -> API, in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for live AI runs and server-authoritative diagnostic grading.
# Project settings -> API -> service_role. Keep this secret server-side.
# Never prefix it NEXT_PUBLIC_ or place it in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini — powers extraction, labelling, damage ranking, reteach packs and
# signature embeddings. Server-side only: never prefix this NEXT_PUBLIC_.
#
# Without it the app runs on the seeded demo class and the run endpoint
# returns 503, rather than starting a batch it cannot finish.
#
# aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Free-tier request quota is charged per day AND per model, and the
# allowance differs sharply between models, so which one can finish a batch
# depends on the account. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Client-side rate limit, requests per rolling minute. Defaults to 15
# to stay inside the free tier; raise it on a paid plan.
# GEMINI_RPM=60
