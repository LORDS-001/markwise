# Supabase — optional. With these unset the app runs on the seeded demo
# class alone, which is how the live demo stays up if anything is missing.
#
# Project settings -> API, in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — powers extraction, labelling, damage ranking, reteach packs and
# signature embeddings. Server-side only: never prefix this NEXT_PUBLIC_.
#
# Without it the app runs on the seeded demo class and the run endpoint
# returns 503, rather than starting a batch it cannot finish.
#
# aistudio.google.com/apikey
GEMINI_API_KEY=
