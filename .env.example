# Supabase — optional. With these unset the app runs on the seeded demo
# class alone, which is how the live demo stays up if anything is missing.
#
# Project settings -> API, in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Gemini — powers extraction, labelling, damage ranking, reteach packs and
# signature embeddings. Server-side only: never prefix this NEXT_PUBLIC_.
#
# Without it the app runs on the seeded demo class and the run endpoint
# returns 503, rather than starting a batch it cannot finish.
#
# Claude runs the four generative stages: extraction, labelling, damage
# ranking, reteach packs. console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini embeds the error signatures. Still required alongside Claude —
# Anthropic publishes no embedding model and clustering needs vectors.
# aistudio.google.com/apikey
GEMINI_API_KEY=

# Required only for an identity-linked API key, which acts inside one
# workspace and rejects any request that does not name it. Console -> Settings
# -> Workspaces. Nothing in the key reveals whether yours is one — the API
# says so on the first call.
# ANTHROPIC_WORKSPACE_ID=

# Optional. Overrides the Claude model. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Free-tier request quota is charged per day AND per model, and the
# allowance differs sharply between models, so which one can finish a batch
# depends on the account. Defaults to gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional. Client-side rate limit, requests per rolling minute. Defaults to 15
# to stay inside the free tier; raise it on a paid plan.
# GEMINI_RPM=60
